# Copy to .env and fill in real values. .env is git-ignored. Never commit it.

# PostgreSQL (docker-compose.yml reads these too)
POSTGRES_USER=kiakia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kiakia
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Telegram: create a bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=

# Times are stored in UTC and shown in this time zone
BUSINESS_TIMEZONE=Africa/Lagos
