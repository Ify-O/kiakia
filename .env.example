# Copy to .env and fill in real values. .env is git-ignored. Never commit it.

# PostgreSQL (docker-compose.yml reads these too)
POSTGRES_USER=kiakia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kiakia
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Telegram: create a bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=

# Times are stored in UTC and shown in this time zone
BUSINESS_TIMEZONE=Africa/Lagos

# Email channel (optional, docs/adr/0010). Use a mailbox made for the business, not your personal one.
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it here (never your normal password).
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_DISPLAY_NAME=Kiakia
# Defaults are Gmail's; change for another provider:
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
